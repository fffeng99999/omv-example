# any later version.

set -e

case "$1" in
	upgrade|failed-upgrade|abort-install|abort-upgrade|disappear|remove|purge)
		# Nothing to do here: the service lifecycle (systemd unit or
		# compose stack) is managed by the Salt state on Apply and by
		# the plugin buttons through omv-example-ctl. Removing the
		# plugin leaves rendered artifacts and data in place.
	;;

	*)
		echo "prerm called with unknown argument '$1'" >&2
		exit 1
	;;
esac

exit 0
