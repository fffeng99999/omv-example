set -e

case "$1" in
	remove)
		# Unregister the Compose stack from the openmediavault-compose
		# plugin: the Compose plugin stops the containers and removes the
		# generated stack files. Data is never touched. Best effort only,
		# a failure must not block the removal.
		/usr/sbin/omv-example-ctl unregister || true
	;;

	upgrade|failed-upgrade|abort-install|abort-upgrade|disappear|purge)
		# Nothing to do here: the service lifecycle (systemd unit or
		# compose stack) is managed by the Salt state on Apply and by
		# the plugin buttons through omv-example-ctl. Removing the
		# plugin leaves data in place.
	;;

	*)
		echo "prerm called with unknown argument '$1'" >&2
		exit 1
	;;
esac

exit 0
