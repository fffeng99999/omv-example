set -e

. /etc/default/openmediavault
. /usr/share/openmediavault/scripts/helper-functions

case "$1" in
	purge)
		echo "Cleaning up configuration database ..."
		omv_config_delete "/config/services/example"
		# Activate trigger to rebuild workbench configuration files.
		dpkg-trigger update-workbench
		# Best-effort cleanup of rendered artifacts (systemd mode).
		# Data directories (compose stack data, /etc/example) are kept.
		if [ -f /etc/systemd/system/example.service ]; then
			systemctl stop example.service >/dev/null 2>&1 || true
			rm -f /etc/systemd/system/example.service
			systemctl daemon-reload >/dev/null 2>&1 || true
		fi
	;;

	remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
		# Activate trigger to rebuild workbench configuration files.
		dpkg-trigger update-workbench
	;;

	*)
		echo "postrm called with unknown argument '$1'" >&2
		exit 1
	;;
esac

exit 0
